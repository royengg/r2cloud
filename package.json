{
  "name": "r2cloud",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "api": "bun apps/api/src/main.ts",
    "worker": "bun apps/api/src/worker-main.ts",
    "publisher": "bun apps/api/src/publisher-main.ts",
    "web": "bun --bun vite --host 127.0.0.1",
    "build": "bun run typecheck && bun --bun vite build",
    "typecheck": "bun --bun tsc --noEmit",
    "db:start": "bash scripts/postgres.sh start",
    "db:stop": "bash scripts/postgres.sh stop",
    "db:generate": "bun --bun prisma generate",
    "db:migrate": "bun --bun prisma migrate deploy",
    "db:setup": "bun run db:generate && bun run db:migrate",
    "test": "bun test --timeout 30000 tests",
    "test:browser": "bun scripts/browser-check.ts",
    "format": "bun --bun prettier --write \"{apps,packages,scripts,tests}/**/*.{ts,tsx,css,json}\"",
    "design:lint": "bun node_modules/@google/design.md/dist/index.js lint DESIGN.md",
    "test:auth-browser": "bun scripts/auth-browser-check.ts",
    "test:seed": "R2_MODE=fixture bun scripts/setup.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@google/design.md": "0.4.0",
    "@r2cloud/adapters": "workspace:*",
    "@r2cloud/contracts": "workspace:*",
    "@r2cloud/core": "workspace:*",
    "@r2cloud/database": "workspace:*",
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "pg": "^8.16.3",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "esbuild"
  ]
}
