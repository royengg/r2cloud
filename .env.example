# Managed database configuration only; never commit actual values.
# DATABASE_URL=postgresql://USER:PASSWORD@PROJECT-pooler.REGION.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@PROJECT.REGION.neon.tech/neondb?sslmode=require
# Without these values, development uses .local/pgsocket, port 55439.
# Default development is product mode; fixture mode is for explicit tests only.

# GitHub-only product sign-in. Missing configuration shows an unavailable sign-in state.
# Set these in the ignored project .env; never send secrets in chat or commit them.
# BETTER_AUTH_URL=http://127.0.0.1:5173
# BETTER_AUTH_SECRET=<dedicated random secret, at least 32 characters>
# GITHUB_CLIENT_ID=<GitHub OAuth app client ID>
# GITHUB_CLIENT_SECRET=<GitHub OAuth app client secret>
# OAuth callback: <BETTER_AUTH_URL>/api/auth/callback/github
# For an approved HTTPS tunnel, BETTER_AUTH_URL and R2_DEV_ORIGIN must match.

# Dedicated worker credentials for the Vercel control plane (not auto-discovered).
# Live worker wiring is still pending; setting these does not launch resources.
# R2_VERCEL_TOKEN=
# R2_VERCEL_TEAM_ID=
# R2_VERCEL_PROJECT_ID=

# Repository connection App: distinct from product sign-in's OAuth app.
# R2_GITHUB_APP_CLIENT_ID=<public GitHub App client ID>
# R2_GITHUB_APP_SLUG=<GitHub App slug>
# Configure the App callback as <BETTER_AUTH_URL>/api/repository-callback.
# Keep the App client secret only in .env.broker (see docs/SETUP.md).
